{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // node16 emits CommonJS here (package.json has no "type": "module"), which is what Electron's
    // main process loads, and avoids the deprecated node10 resolution.
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/__tests__/**"]
}
